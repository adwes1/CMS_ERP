# Öffentliche Adresse aus Sicht des Browsers, ohne abschließenden Slash.
# APP_PORT und der Port in APP_ORIGIN müssen übereinstimmen.
APP_ORIGIN=http://192.168.1.20:8080
APP_PORT=8080

# Bei einem Fork IMAGE_NAMESPACE auf den eigenen, kleingeschriebenen
# GitHub-Benutzernamen bzw. Organisationsnamen setzen.
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=adwes1
IMAGE_TAG=latest

POSTGRES_DB=cms_erp
POSTGRES_USER=cms_erp
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD
KEYCLOAK_APP_ADMIN_PASSWORD=CHANGE_ME_APP_ADMIN_PASSWORD
KEYCLOAK_API_CLIENT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
INTEGRATION_ENCRYPTION_KEY=CHANGE_ME_SEPARATE_RANDOM_ENCRYPTION_KEY
